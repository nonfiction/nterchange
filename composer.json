{
  "name": "nonfiction/nterchange",
  "description": "Shared nterchange CMS runtime for existing sites on PHP 8.5",
  "type": "library",
  "license": "PHP-3.01",
  "require": {
    "php": "~8.5.0",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-mysqli": "*",
    "ext-session": "*",
    "ext-simplexml": "*"
  },
  "autoload": {
    "classmap": ["lib/", "app/"],
    "files": ["bootstrap.php"]
  },
  "include-path": ["./", "lib/", "lib/view/", "app/controllers/", "vendor/", "compat/pear/"],
  "extra": {
    "branch-alias": {"dev-main": "5.0.x-dev"}
  },
  "scripts": {
    "test": ["@php tests/runtime.php", "@php tests/audit-year.php", "@php tests/pagination-mail.php", "@php tests/cache.php", "@php tests/layout-assets.php", "@php tests/page-content-insert.php"]
  }
}
